---
import Base from '@layouts/Base.astro';
import { Button } from '@components/ui/Button';
---

<Base title="Lost in the valley" description="This page wandered off. Head back to BCHacks." base="/" noindex showNotice={false}>
  <section class="lost" aria-labelledby="lost-title">
    <div class="container lost__inner">
      <p class="eyebrow">Off the map</p>
      <p class="lost__code mono" aria-hidden="true">404</p>
      <h1 id="lost-title" class="title-font">Lost in the <span class="sky-text">valley</span></h1>
      <p class="lost__text">This trail goes nowhere. The page moved, or the link has a typo.</p>
      <div class="lost__actions">
        <Button href="/" icon="arrow">Back to BCHacks</Button>
        <Button href="/#faq" variant="secondary">Read the FAQ</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    overflow-x: clip;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + var(--s-9)) 0 clamp(160px, 20vw, 260px);
    min-height: 92svh;
  }
  .lost__inner {
    position: relative;
    z-index: 1;
  }
  /* The number is drawn as a blueprint outline, not filled. */
  .lost__code {
    margin-top: var(--s-4);
    font-size: clamp(4.5rem, 3rem + 7vw, 9rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--sky);
  }
  h1 {
    margin-top: var(--s-3);
    font-size: var(--h1);
  }
  .lost__text {
    max-width: 38ch;
    margin-top: var(--s-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
