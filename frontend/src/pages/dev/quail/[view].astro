---
/**
 * Dev-only quail review: /dev/quail/front | three-quarter | side | wave | phone.
 * Add ?t=SECONDS to freeze the idle animation at an exact moment. Not built for production.
 */
export function getStaticPaths() {
  // Declared inside: Astro runs getStaticPaths in isolation from the rest of the frontmatter.
  const views = ['front', 'three-quarter', 'side', 'wave', 'phone'];
  return import.meta.env.DEV ? views.map((view) => ({ params: { view } })) : [];
}
const { view } = Astro.params;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Quail · {view}</title>
    <!-- React fast-refresh preamble (dev-only page; Astro injects it only for client:* islands). -->
    <script is:inline type="module">
      import RefreshRuntime from '/@react-refresh';
      RefreshRuntime.injectIntoGlobalHook(window);
      window.$RefreshReg$ = () => {};
      window.$RefreshSig$ = () => (type) => type;
      window.__vite_plugin_react_preamble_installed__ = true;
    </script>
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #0f1539;
      }
      #world {
        position: fixed;
        inset: 0;
      }
      /* phone: the bird at real hero-stage size inside a 390-wide stage box */
      html[data-view='phone'] #world {
        inset: auto;
        top: 72px;
        left: 0;
        right: 0;
        height: clamp(300px, 82vw, 380px);
        outline: 1px dashed rgb(132 219 247 / 0.35);
      }
      .tag {
        position: fixed;
        left: 16px;
        top: 14px;
        z-index: 2;
        margin: 0;
        font: 500 12px ui-monospace, Consolas, monospace;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #84dbf7;
      }
    </style>
  </head>
  <body>
    <p class="tag">Quail · {view}</p>
    <div id="world" data-view={view}></div>
    <script is:inline define:vars={{ view }}>
      document.documentElement.dataset.view = view;
    </script>
    <script>
      if (import.meta.env.DEV) {
        import('../../../world/quail/mountQuail').then(({ mountQuail }) => mountQuail(document.getElementById('world')!));
      }
    </script>
  </body>
</html>
