---
/**
 * /live — event-day page. Linked from the hero only when site.state is "live".
 * Utility first: it is used on phones in a busy room, so it stays on the dark,
 * high-contrast end of the dusk palette.
 */
import Base from '@layouts/Base.astro';
import { Button } from '@components/ui/Button';
import { Icon } from '@components/ui/Icon';
import { Schedule } from '@components/sections/Schedule';
import { Placeholder } from '@components/ui/Placeholder';
import { site } from '@content/site';
import { live } from '@content/live';
import { formatDateTime } from '../lib/richText';

const announcements = [...live.announcements].sort((a, b) => b.date.localeCompare(a.date));
---

<Base
  title="Live"
  description={`Schedule, map, Wi-Fi, Discord and announcements for ${site.edition}.`}
  base="/"
  noindex={site.state !== 'live'}
  showNotice={false}
>
  <div class="live">

    <header class="container live__head">
      <p class="live__badge mono">
        {site.state === 'live' ? <><span class="live__dot" aria-hidden="true"></span>Live now</> : 'Event-day page'}
      </p>
      <h1 class="title-font">{site.edition} <span class="sky-text">live</span></h1>
      <p class="live__sub mono">{site.datesLabel} · {site.venue.building}</p>
      <div class="live__actions">
        <Button href={site.discordUrl} icon="arrow" external>Open Discord</Button>
        <Button href={live.devpostUrl} variant="secondary" external>Submit on Devpost</Button>
      </div>
    </header>

    <div class="container live__grid">
      <section class="card panel panel--news" aria-labelledby="news-title">
        <h2 id="news-title" class="panel__title"><Icon name="radio" /> Announcements</h2>
        {announcements.length === 0 ? (
          <Placeholder title="Nothing yet" text="Announcements appear here and on Discord during the event." />
        ) : (
          <ol role="list" class="news">
            {announcements.map((a) => (
              <li class="news__item">
                <time class="mono news__time" datetime={a.date}>{formatDateTime(a.date)}</time>
                <h3 class="news__title">{a.title}</h3>
                <p>{a.body}</p>
              </li>
            ))}
          </ol>
        )}
      </section>

      <section class="card panel" aria-labelledby="wifi-title">
        <h2 id="wifi-title" class="panel__title"><Icon name="wifi" /> Wi-Fi</h2>
        <dl class="kv">
          <div><dt>Network</dt><dd class="mono">{live.wifi.network}</dd></div>
          <div><dt>Password</dt><dd>{live.wifi.password}</dd></div>
        </dl>
        <p class="panel__note">{live.wifi.note}</p>
      </section>

      <section class="card panel" aria-labelledby="map-title">
        <h2 id="map-title" class="panel__title"><Icon name="map" /> Venue</h2>
        {live.venueMap.image ? (
          <img src={live.venueMap.image} alt={live.venueMap.alt} width="1200" height="800" loading="lazy" decoding="async" class="venue-map" />
        ) : (
          <Placeholder title="Map coming soon" text="We'll post the floor plan here before doors open." />
        )}
        <dl class="kv kv--rooms">
          {live.rooms.map((r) => <div><dt>{r.name}</dt><dd>{r.where}</dd></div>)}
        </dl>
        <a class="panel__link" href={site.venue.mapsUrl} target="_blank" rel="noopener">
          Directions to {site.venue.name}<span class="visually-hidden"> (opens in a new tab)</span> <Icon name="external" size={18} />
        </a>
      </section>

      <section class="card panel" aria-labelledby="judging-title">
        <h2 id="judging-title" class="panel__title"><Icon name="trophy" /> Judging</h2>
        <ol role="list" class="steps">
          {live.judging.map((j) => <li>{j}</li>)}
        </ol>
      </section>
    </div>

    <section class="container live__schedule" aria-labelledby="live-schedule-title">
      <h2 id="live-schedule-title" class="panel__title"><Icon name="clock" /> Schedule</h2>
      <Schedule id="live-schedule" />
    </section>
  </div>
</Base>

<style>
  .live {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + var(--s-7)) 0 var(--s-9);
  }

  .live__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-xs);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--sky);
  }
  .live__dot {
    width: 10px;
    height: 11.5px;
    background: var(--sky);
    clip-path: var(--hexagon);
    animation: pulse 1.6s var(--ease-in-out) infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.4;
      transform: scale(1.4);
    }
  }
  .live__head h1 {
    margin-top: var(--s-3);
    font-size: var(--h1);
  }
  .live__sub {
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .live__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .live__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    margin-top: var(--s-8);
  }
  @media (min-width: 900px) {
    .live__grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .panel {
    --cut-size: var(--chamfer-lg);
    padding: var(--s-6) var(--s-5);
  }
  .panel__title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    font-size: var(--h3);
  }
  .panel__title :global(.icon) {
    color: var(--sky);
  }
  .panel__note {
    margin-top: var(--s-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-top: var(--s-3);
    font-weight: 500;
    color: var(--sky);
  }

  .news__item {
    padding: var(--s-4) 0;
    border-top: 1px solid var(--line);
  }
  .news__time {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .news__title {
    margin: var(--s-1) 0 var(--s-2);
    font-size: var(--text-xl);
  }
  .news p {
    color: var(--text-muted);
  }

  .kv {
    display: grid;
    gap: var(--s-2);
  }
  .kv div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line);
  }
  .kv dt {
    color: var(--text-muted);
  }
  .kv dd {
    font-weight: 500;
  }
  .kv--rooms {
    margin-top: var(--s-4);
  }
  .venue-map {
    width: 100%;
    background: var(--white);
  }

  .steps {
    display: grid;
    gap: var(--s-3);
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-left: var(--s-7);
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 32px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--sky);
    clip-path: var(--hexagon);
  }

  .live__schedule {
    margin-top: var(--s-8);
  }
</style>
